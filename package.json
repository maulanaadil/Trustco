{
    "name": "trustco",
    "version": "1.0.0",
    "private": true,
    "description": "trustco",
    "author": "Maulana Adil",
    "keywords": [
        "gatsby"
    ],
    "scripts": {
        "develop": "gatsby develop",
        "start": "gatsby develop",
        "build": "gatsby build",
        "serve": "gatsby serve",
        "clean": "gatsby clean",
        "lint": "eslint \"**/*.{js,jsx}\"",
        "lint-fix": "eslint \"**/*.{js,jsx}\" --fix",
        "precommit": "lint-staged",
        "prepare": "husky install",
        "prettier:check": "prettier --config .prettierrc --check \"src/**/*.{js, jsx, json,css,html}\""
    },
    "lint-staged": {
        "src/**/*.{jsx, js, json, css,html}": [
            "yarn run prettier:check"
        ]
    },
    "husky": {
        "hooks": {
            "pre-commit": "yarn run prettier:check",
            "pre-push": "yarn run clean"
        }
    },
    "dependencies": {
        "@heroicons/react": "^2.0.8",
        "dotenv": "^16.0.1",
        "framer-motion": "^7.2.0",
        "gatsby": "^4.21.1",
        "gatsby-alias-imports": "^1.0.6",
        "gatsby-plugin-chatwoot": "^1.1.0",
        "gatsby-plugin-image": "^2.21.0",
        "gatsby-plugin-manifest": "^4.21.0",
        "gatsby-plugin-react-helmet": "^5.21.0",
        "gatsby-plugin-sharp": "^4.21.0",
        "gatsby-source-filesystem": "^4.21.1",
        "gatsby-transformer-sharp": "^4.21.0",
        "lottie-web": "^5.9.6",
        "prettier": "^2.7.1",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-helmet": "^6.1.0",
        "tailwindcss-classnames": "^3.0.6"
    },
    "devDependencies": {
        "autoprefixer": "^10.4.8",
        "gatsby-plugin-postcss": "^5.21.0",
        "husky": "^8.0.1",
        "lint-staged": "^13.0.3",
        "postcss": "^8.4.16",
        "tailwindcss": "^3.1.8"
    }
}
